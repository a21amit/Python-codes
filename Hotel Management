"""
=========================================================
PROJECT: HOTEL MANAGEMENT SYSTEM (PYTHON & MYSQL)
=========================================================

DESCRIPTION:
This is a command-line based Hotel Management System that 
demonstrates database connectivity, basic CRUD operations, 
and input validation using Python and MySQL.

PREREQUISITES (For the Examiner):
1. Python must be installed.
2. MySQL Server must be installed and running.
3. Install the required module by running this in the terminal:
   pip install mysql-connector-python

SETUP INSTRUCTIONS:
Please scroll down to the 'Database Configuration' section 
(around line 30) and update the DB_USER and DB_PASSWORD 
variables to match your local MySQL credentials. 

NOTE: You do NOT need to create the database manually. 
The program will automatically create the database and 
tables on its first run.
=========================================================
"""

import mysql.connector
from mysql.connector import Error
import os
import time

# ==========================================
# DATABASE CONFIGURATION
# (Sir/Ma'am, please update these credentials)
# ==========================================
DB_HOST = "localhost"
DB_USER = "root"          # <-- UPDATE THIS
DB_PASSWORD = "password"  # <-- UPDATE THIS
DB_NAME = "hotel_management"
# ==========================================

class HotelManager:
    def __init__(self):
        self.conn = None
        self.cursor = None
        self.connect_to_db()

    def clear_screen(self):
        """Clears the console screen for a cleaner UI."""
        os.system('cls' if os.name == 'nt' else 'clear')

    def connect_to_db(self):
        """Connects to MySQL server and initializes the database if missing."""
        try:
            # First, connect without a specific database to ensure it exists
            temp_conn = mysql.connector.connect(
                host=DB_HOST,
                user=DB_USER,
                password=DB_PASSWORD
            )
            temp_cursor = temp_conn.cursor()
            
            # Auto-create database if it doesn't exist
            temp_cursor.execute(f"CREATE DATABASE IF NOT EXISTS {DB_NAME}")
            temp_conn.close()

            # Now connect to the actual project database
            self.conn = mysql.connector.connect(
                host=DB_HOST,
                user=DB_USER,
                password=DB_PASSWORD,
                database=DB_NAME
            )
            self.cursor = self.conn.cursor()
            
            # Auto-create the guests table if it doesn't exist
            table_query = """
            CREATE TABLE IF NOT EXISTS guests (
                guest_id INT AUTO_INCREMENT PRIMARY KEY,
                name VARCHAR(100) NOT NULL,
                phone VARCHAR(15) NOT NULL,
                room_type VARCHAR(20),
                days INT,
                total_bill INT
            )
            """
            self.cursor.execute(table_query)
            self.conn.commit()

        except Error as e:
            print(f"\n[!] Database Connection Error: {e}")
            print("[!] Please check the DB_USER and DB_PASSWORD variables at the top of the code.")
            exit()

    def get_valid_integer(self, prompt):
        """Helper to ensure the user enters a valid number instead of letters."""
        while True:
            try:
                value = int(input(prompt))
                return value
            except ValueError:
                print("Invalid input. Please enter a valid number.")

    def check_in(self):
        self.clear_screen()
        print("=== Guest Check-In ===\n")
        
        name = input("Enter Guest Name: ").strip()
        phone = input("Enter Phone Number: ").strip()
        
        print("\nAvailable Room Types:")
        print("1. Standard  - Rs. 1000/night")
        print("2. Deluxe    - Rs. 2000/night")
        print("3. Suite     - Rs. 3000/night")
        
        while True:
            room_choice = input("\nSelect Room (1-3): ").strip()
            if room_choice in ['1', '2', '3']:
                break
            print("Invalid choice. Please select 1, 2, or 3.")

        days = self.get_valid_integer("Enter number of days staying: ")

        # Map choices to room types and prices
        room_rates = {'1': ("Standard", 1000), '2': ("Deluxe", 2000), '3': ("Suite", 3000)}
        room_type, price_per_day = room_rates[room_choice]
        total_bill = price_per_day * days

        try:
            sql = "INSERT INTO guests (name, phone, room_type, days, total_bill) VALUES (%s, %s, %s, %s, %s)"
            val = (name, phone, room_type, days, total_bill)
            self.cursor.execute(sql, val)
            self.conn.commit()
            
            print(f"\nSuccess! {name} has been assigned a {room_type} room.")
            print(f"Total estimated bill: Rs. {total_bill}")
        except Error as e:
            print(f"\nFailed to check-in guest: {e}")
            
        input("\nPress Enter to return to main menu...")

    def view_guests(self):
        self.clear_screen()
        print("=== Current Guests ===\n")
        
        try:
            self.cursor.execute("SELECT * FROM guests")
            records = self.cursor.fetchall()
            
            if not records:
                print("No guests are currently checked in.")
            else:
                # Formatting the output as a clean table
                print(f"{'ID':<5} | {'Name':<20} | {'Phone':<15} | {'Room Type':<10} | {'Days':<5} | {'Bill':<10}")
                print("-" * 75)
                for row in records:
                    print(f"{row[0]:<5} | {row[1]:<20} | {row[2]:<15} | {row[3]:<10} | {row[4]:<5} | Rs. {row[5]}")
        except Error as e:
            print(f"\nFailed to fetch records: {e}")
            
        input("\nPress Enter to return to main menu...")

    def check_out(self):
        self.clear_screen()
        print("=== Guest Check-Out ===\n")
        
        guest_id = self.get_valid_integer("Enter the Guest ID to check out: ")
        
        try:
            # First verify the guest exists
            self.cursor.execute("SELECT name, total_bill FROM guests WHERE guest_id = %s", (guest_id,))
            guest = self.cursor.fetchone()
            
            if guest:
                print(f"\nInitiating check-out for: {guest[0]}.")
                print(f"Please collect payment of Rs. {guest[1]}")
                
                # Ask for confirmation before deleting
                confirm = input("\nConfirm checkout? (y/n): ").strip().lower()
                if confirm == 'y':
                    self.cursor.execute("DELETE FROM guests WHERE guest_id = %s", (guest_id,))
                    self.conn.commit()
                    print("Check-out complete. Record removed from database.")
                else:
                    print("Check-out cancelled.")
            else:
                print(f"\nNo guest found with ID {guest_id}.")
                
        except Error as e:
            print(f"\nDatabase error during check-out: {e}")
            
        input("\nPress Enter to return to main menu...")

    def run(self):
        """Main application loop."""
        while True:
            self.clear_screen()
            print("====================================")
            print("      HOTEL MANAGEMENT SYSTEM       ")
            print("====================================")
            print("1. Check-In New Guest")
            print("2. View All Guests")
            print("3. Check-Out Guest")
            print("4. Exit")
            print("====================================")
            
            choice = input("Enter your choice (1-4): ").strip()
            
            if choice == '1':
                self.check_in()
            elif choice == '2':
                self.view_guests()
            elif choice == '3':
                self.check_out()
            elif choice == '4':
                print("\nClosing system. Goodbye!")
                if self.conn and self.conn.is_connected():
                    self.cursor.close()
                    self.conn.close()
                break
            else:
                print("Invalid choice. Please try again.")
                time.sleep(1.5)

# Application Entry Point
if __name__ == "__main__":
    # Wrap in a try-except to handle Ctrl+C gracefully without throwing messy errors
    try:
        app = HotelManager()
        app.run()
    except KeyboardInterrupt:
        print("\n\nSystem interrupted by user. Exiting safely...")
        exit()
